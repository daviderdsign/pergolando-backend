// One deployment per tenant (see README): no tenant_id column anywhere —
// isolation is the separate container + separate SQLite file, not a query filter.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7); the runtime
// PrismaClient gets its connection via a driver adapter instead — see
// src/prisma/prisma.service.ts.
datasource db {
  provider = "sqlite"
}

model Seller {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  /// Null until the email is confirmed via a VerificationCode. Login is
  /// blocked while null when EMAIL_VERIFICATION_ENABLED=true.
  emailVerifiedAt     DateTime?
  /// Consecutive failed login attempts; reset to 0 on success. Drives the
  /// per-account lockout in AuthService (separate from the per-IP throttle).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  sessions          Session[]
  verificationCodes VerificationCode[]

  @@map("sellers")
}

enum VerificationCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationCode {
  id         String                  @id @default(cuid())
  sellerId   String
  seller     Seller                  @relation(fields: [sellerId], references: [id])
  purpose    VerificationCodePurpose
  /// Argon2id hash of the 6-digit code — never store it in plaintext, same
  /// reasoning as passwords: a DB dump shouldn't hand out working codes.
  codeHash   String
  /// Incremented on each failed check; the code is rejected outright past
  /// MAX_VERIFICATION_ATTEMPTS regardless of TTL, to make brute-forcing a
  /// 6-digit space impractical even before it expires.
  attempts   Int                     @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                @default(now())

  @@index([sellerId, purpose])
  @@map("verification_codes")
}

model Session {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@map("sessions")
}

model EndClient {
  id        String    @id @default(cuid())
  nome      String
  cognome   String
  indirizzo String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotes Quote[]

  @@map("end_clients")
}

enum QuoteStatus {
  DRAFT
  SENT
  SIGNED
}

model Quote {
  id             String      @id @default(cuid())
  endClientId    String
  endClient      EndClient   @relation(fields: [endClientId], references: [id])
  status         QuoteStatus @default(DRAFT)
  bundleVersion  String
  /// JSON-encoded configuration + price breakdown from the pricing engine.
  configuration  String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([endClientId])
  @@map("quotes")
}

// A deployment belongs to one dealer. In this first release a seller owns each case.
model CustomerCase {
 supportAccesses SupportAccess[]
 supportTickets SupportTicket[]
 handovers CaseHandover[]
 installationEvents CaseInstallationEvent[]
 orders CaseOrderBatch[]
 paymentChecks CasePaymentCheck[]
 activities CaseActivity[]
 id String @id @default(cuid())
 sellerId String
 firstName String
 lastName String
 email String
 phone String
 address String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 items CaseItem[]
 financeRevision Int @default(0)
 costsComplete Boolean @default(false)
 deliveredAt DateTime?
 financeEntries CaseFinanceEntry[]
 financeDocuments CaseFinanceDocument[]
 proposals CaseProposal[]
 media CaseMedia[]
 proposalRevision Int @default(0)
 acceptedProposalId String?
 confirmedProposalId String?
 @@index([sellerId, updatedAt])
 @@map("customer_cases")
 caseName String @default("")
 companyName String @default("")
 siteAddress String @default("")
 projectNotes String @default("")
 creationKey String?
 files CaseFile[]
 @@unique([sellerId,creationKey])

}
