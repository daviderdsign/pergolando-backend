# SQLite file for this tenant's deployment — one file per instance, never shared.
DATABASE_URL="file:./data/db.sqlite"

# Folder with this tenant's bundle (manifest.json, catalog/, branding/), as
# exported by Studio — one bundle per deployment, mounted read-only in production.
BUNDLE_PATH="./data/bundle"

PORT=3001

# Comma-separated origins allowed to call this API (the tenant's frontend).
CORS_ORIGIN="http://localhost:3000"

# Session cookie is httpOnly/Secure/SameSite regardless; set to "false" only
# for local HTTP-only development, never in production.
SESSION_COOKIE_SECURE=true
