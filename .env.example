# SQLite file for this tenant's deployment — one file per instance, never shared.
DATABASE_URL="file:./data/db.sqlite"

# Folder with this tenant's bundle (manifest.json, catalog/, branding/), as
# exported by Studio — one bundle per deployment, mounted read-only in production.
BUNDLE_PATH="./data/bundle"

PORT=3001

# Comma-separated origins allowed to call this API (the tenant's frontend).
CORS_ORIGIN="http://localhost:3000"

# Session cookie is httpOnly/Secure/SameSite regardless; set to "false" only
# for local HTTP-only development, never in production.
SESSION_COOKIE_SECURE=true

# If "false", registration skips the 6-digit email confirmation step and
# login never checks it — useful for local dev without SMTP configured.
# Defaults to enabled (anything other than the literal string "false").
EMAIL_VERIFICATION_ENABLED=true

# SMTP used to send the verification/password-reset 6-digit codes. If
# SMTP_HOST is unset, sends are logged instead of attempted (see
# src/mail/mail.service.ts) rather than failing hard.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Google Gemini API key for the photorealistic render feature (POST
# catalog/render, gemini-2.5-flash-image / "Nano Banana"). Optional — unlike
# BUNDLE_PATH this never blocks startup; if unset, the render endpoint
# responds with a clear RENDER_NON_CONFIGURATO error instead (see
# src/render/render.service.ts).
GEMINI_API_KEY=

# Base URL of the isolated pergolando-blender-service (its own container —
# Blender is a ~300MB dependency deliberately kept out of this backend's own
# image, see ../pergolando-blender-service and 3d/NOTES.md), for the real
# parametric 3D render feature (POST catalog/render3d — pipeline step 4).
# Optional, same pattern as GEMINI_API_KEY above: unset means a clear
# RENDER_3D_NON_CONFIGURATO error instead of blocking startup.
BLENDER_SERVICE_URL=

# Base URL of the isolated pergolando-geocalib-service (its own container —
# GeoCalib is a PyTorch model, kept out of this backend's own image, same
# reasoning as BLENDER_SERVICE_URL above), for the real camera-perspective
# feature (POST catalog/perspective — pipeline step 3). Optional, same
# pattern: unset means a clear PROSPETTIVA_NON_CONFIGURATA error instead of
# blocking startup.
GEOCALIB_SERVICE_URL=
